# Optional online backend. Leave both unset for the free local SQLite/files preview.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Keep the secret API key on the server. Never prefix it with NEXT_PUBLIC or VITE.

# Public HTTPS origin, without a path. Set before launch to enable indexing,
# the canonical URL, social images and sitemap. Preview stays noindex while unset.
SITE_URL=

